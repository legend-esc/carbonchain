{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "^../node_modules/pg/.*",
    "^../node_modules/(?!@stellar/|uint8array-extras/).+"
  ],
  "setupFiles": ["<rootDir>/setup.ts"]
}
