# Non-secret configuration. Secrets go in secrets/.env.secrets (see secrets/.env.secrets.example).
#
# Copy this file to api/.env:
#   cp api/.env.example api/.env
#
# Then copy and fill in the secrets file:
#   cp secrets/.env.secrets.example secrets/.env.secrets
#
# Variables marked [SECRET] must NOT be placed here — put them in secrets/.env.secrets instead.

# ── Stellar Network ───────────────────────────────────────────────────────────
STELLAR_NETWORK=TESTNET
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Stellar admin keypair ─────────────────────────────────────────────────────
# Public key is safe here; secret key belongs in secrets/.env.secrets.
ADMIN_PUBLIC_KEY=G...
# [SECRET] ADMIN_SECRET_KEY — set in secrets/.env.secrets

# ── SEP-10 ────────────────────────────────────────────────────────────────────
HOME_DOMAIN=localhost

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200

# ── JWT ───────────────────────────────────────────────────────────────────────
# [SECRET] JWT_SECRET — set in secrets/.env.secrets
JWT_EXPIRES_IN=7d

# ── Oracle webhook ────────────────────────────────────────────────────────────
# [SECRET] ORACLE_WEBHOOK_SECRET — set in secrets/.env.secrets
WEBHOOK_ALLOWED_IPS=127.0.0.1/32,10.0.0.0/24

# ── Contract IDs (populated after running scripts/deploy-testnet.sh) ──────────
CREDIT_REGISTRY_CONTRACT_ID=C...
RETIREMENT_CONTRACT_ID=C...
MARKETPLACE_CONTRACT_ID=C...
MRV_ORACLE_CONTRACT_ID=C...

# ── Database ──────────────────────────────────────────────────────────────────
# [SECRET] DATABASE_URL — set in secrets/.env.secrets (contains password)
# [SECRET] DATABASE_REPLICA_URLS — set in secrets/.env.secrets (contains password)
# Fallback for local dev without Docker (no secrets file):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carbonchain
DATABASE_REPLICA_URLS=postgresql://postgres:postgres@localhost:5433/carbonchain

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=120

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
