# Stellar Network
STELLAR_NETWORK=TESTNET
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Admin keypair (never expose to frontend)
ADMIN_SECRET_KEY=S...
ADMIN_PUBLIC_KEY=G...

# SEP-10
HOME_DOMAIN=localhost

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Contract IDs (populated after deploy-testnet.sh)
CREDIT_REGISTRY_CONTRACT_ID=C...
RETIREMENT_CONTRACT_ID=C...
MARKETPLACE_CONTRACT_ID=C...
MRV_ORACLE_CONTRACT_ID=C...

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carbonchain

# Redis (cache + rate limiting)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=120

# Logging (fatal|error|warn|info|debug|trace|silent)
LOG_LEVEL=info

# Rate limiting — comma-separated IPv4 CIDR ranges that bypass throttling entirely.
# Use this to allowlist CI runner IPs and internal load balancers.
# Leave empty (default) in production.
# Example: THROTTLER_SKIP_IPS=127.0.0.1/8,10.0.0.0/8
THROTTLER_SKIP_IPS=
