# `cargo test` run and add noise to PRs.
coverage/
__snapshots__/
*.snap
junit.xml
test-results/
.nyc_output/
lcov.info
*.lcov
# Soroban test snapshots (auto-generated, not source — issue PR checklist)
test_snapshots/
# Karma / browser test output
karma-test-results.xml
browser_test_results/
# Vitest / Jest cache
.vitest-cache/
.jest-cache/
# Jest coverage directory (alternative name)
jest-coverage/

# Build artifacts
*.js.map
*.d.ts.map
build/
# Rust/Soroban compiled output
*.wasm
Cargo.lock

