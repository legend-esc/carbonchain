# =============================================================================
# CarbonChain — SECRET environment variables
#
# Copy this file to secrets/.env.secrets and fill in real values.
#   cp secrets/.env.secrets.example secrets/.env.secrets
#
# NEVER commit secrets/.env.secrets to version control.
# This file (secrets/.env.secrets.example) IS tracked in git as a template.
#
# Generation commands:
#   ADMIN_SECRET_KEY      : stellar keys generate admin
#   JWT_SECRET            : openssl rand -hex 32
#   ORACLE_WEBHOOK_SECRET : openssl rand -hex 32
# =============================================================================

# ── Stellar admin keypair ─────────────────────────────────────────────────────
# The admin's Stellar secret key. Never expose to the frontend.
# Generate: stellar keys generate admin   (prints G... public / S... secret)
ADMIN_SECRET_KEY=S...

# ── JWT ───────────────────────────────────────────────────────────────────────
# Random 256-bit hex secret for signing JWTs.
# Generate: openssl rand -hex 32
JWT_SECRET=

# ── Oracle webhook HMAC secret ────────────────────────────────────────────────
# Shared secret used to verify HMAC signatures on incoming MRV oracle webhooks.
# Generate: openssl rand -hex 32
ORACLE_WEBHOOK_SECRET=

# ── Database credentials ──────────────────────────────────────────────────────
# Full connection URLs including username and password.
# In Docker Compose these override the values set in docker-compose.yml's
# environment block; use the service name as the host (e.g. `postgres`).
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/carbonchain
DATABASE_REPLICA_URLS=postgresql://postgres:CHANGE_ME@postgres-replica:5432/carbonchain

# ── PostgreSQL passwords ──────────────────────────────────────────────────────
# Used by the postgres and postgres-replica Docker services.
# Must match the passwords embedded in DATABASE_URL / DATABASE_REPLICA_URLS above.
POSTGRES_PASSWORD=CHANGE_ME
REPLICATION_PASSWORD=CHANGE_ME
